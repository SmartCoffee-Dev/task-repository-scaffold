#!/usr/bin/env python3
"""Project command-line entry point."""

from __future__ import annotations

import sys
from pathlib import Path


def main(arguments: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if arguments is None else arguments)
    if not arguments:
        print("usage: task-repository dashboard [--db PATH] [--port PORT]", file=sys.stderr)
        return 2
    if arguments[0] != "dashboard":
        print(f"error: unknown command: {arguments[0]}", file=sys.stderr)
        return 2

    scripts_directory = Path(__file__).resolve().parent / "scripts"
    sys.path.insert(0, str(scripts_directory))
    from dashboard import main as dashboard_main

    return dashboard_main(arguments[1:])


if __name__ == "__main__":
    raise SystemExit(main())

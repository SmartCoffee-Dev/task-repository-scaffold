#!/usr/bin/env python3
"""Project command-line entry point."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


SCRIPTS_DIR = Path(__file__).resolve().parent / "scripts"
sys.path.insert(0, str(SCRIPTS_DIR))


def main(arguments: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if arguments is None else arguments)
    if not arguments:
        print(
            "usage: task-repository <command> [<args>]\n"
            "\n"
            "Available commands:\n"
            "  dashboard      Start the local feature-definition web dashboard\n"
            "  scaffold-db    Create the SQLite database for feature tracking\n"
            "  link-commands  Create or remove symlinks for agentic command files",
            file=sys.stderr,
        )
        return 2

    command = arguments[0]
    rest = arguments[1:]

    if command == "dashboard":
        from dashboard import main as dashboard_main
        return dashboard_main(rest)

    if command == "scaffold-db":
        from scaffold_db import main as scaffold_main
        return scaffold_main(rest)

    if command == "link-commands":
        script = SCRIPTS_DIR / "link-commands.sh"
        return subprocess.run([str(script), *rest]).returncode

    print(f"error: unknown command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

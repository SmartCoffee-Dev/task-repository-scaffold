generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// SPECS — Identidad de cada feature
// ============================================================

model specs {
  id                 Int    @id @default(autoincrement())
  title              String                                      /// Título no vacío de la feature
  slug               String @unique                              /// Slug único (minúsculas, dígitos, guiones)
  description        String                                      /// Request Markdown no vacío
  current_revision_id Int?                                       /// FK a la revisión vigente (si existe)
  created_at         String @default("CURRENT_TIMESTAMP")
  updated_at         String @default("CURRENT_TIMESTAMP")

  currentRevision   spec_revisions?   @relation("SpecCurrentRevision", fields: [current_revision_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions         spec_revisions[]  @relation("SpecRevisions")
  definitionItems   definition_items[]
  tasks             tasks[]
}

// ============================================================
// SPEC_REVISIONS — Snapshots inmutables del Markdown de cada spec
// ============================================================

model spec_revisions {
  id              Int    @id @default(autoincrement())
  spec_id         Int
  revision_number Int                                       /// Secuencial, positivo, empieza en 1
  content         String                                    /// Markdown completo no vacío (inmutable)
  created_at      String @default("CURRENT_TIMESTAMP")

  spec                specs               @relation("SpecRevisions", fields: [spec_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  currentRevisionOf   specs[]             @relation("SpecCurrentRevision")
  incorporatedItems   definition_items[]  @relation("IncorporatedItems")

  @@unique([spec_id, revision_number])
  @@index([spec_id, created_at])
}

// ============================================================
// DEFINITION_ITEMS — Asuntos que requieren decisión humana
// ============================================================

model definition_items {
  id                          Int     @id @default(autoincrement())
  spec_id                     Int
  type                        String                                   /// clarification | tension | impact | example
  source                      String                                   /// description | spec | base_branch
  title                       String                                   /// Título no vacío
  description                 String                                   /// Contexto del asunto
  question                    String?                                  /// Obligatoria para clarification
  suggested_resolution        String?
  example_type                String?                                  /// happy-path | edge-case (solo para example)
  fingerprint                 String                                   /// Identificador estable para deduplicación
  status                      String  @default("pending")              /// pending | accepted | rejected | incorporated
  accepted_revision_number    Int     @default(0)
  incorporated_in_revision_id Int?                                     /// FK a spec_revisions (solo si status = incorporated)
  created_at                  String  @default("CURRENT_TIMESTAMP")
  updated_at                  String  @default("CURRENT_TIMESTAMP")

  spec                  specs               @relation(fields: [spec_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  incorporatedInRevision spec_revisions?     @relation("IncorporatedItems", fields: [incorporated_in_revision_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  responses             definition_responses[]

  @@index([spec_id, type])
  @@index([spec_id, status])
}

// ============================================================
// DEFINITION_RESPONSES — Historial de interacciones sobre items
// ============================================================

model definition_responses {
  id                  Int     @id @default(autoincrement())
  definition_item_id  Int
  response_type       String                              /// answer | accept | reject | observation
  content             String  @default("")                /// Obligatorio para answer/observation
  created_at          String  @default("CURRENT_TIMESTAMP")

  definitionItem      definition_items @relation(fields: [definition_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([definition_item_id, created_at])
}

// ============================================================
// TASKS — Actividades de implementación (árbol dentro de una spec)
// ============================================================

model tasks {
  id            Int     @id @default(autoincrement())
  spec_id       Int                                                 /// FK inmutable tras creación
  title         String                                              /// Título Markdown no vacío
  description   String                                              /// Descripción Markdown
  status        String  @default("pending")                         /// blocked | pending | wip | in_review | done
  parent_id     Int?                                                /// FK recursiva (misma spec)
  branch        String?                                             /// Nombre de rama (no vacío si existe)
  created_at    String  @default("CURRENT_TIMESTAMP")
  updated_at    String  @default("CURRENT_TIMESTAMP")

  spec              specs                @relation(fields: [spec_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent            tasks?               @relation("TaskHierarchy", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children          tasks[]              @relation("TaskHierarchy")
  sessionLogs       session_logs[]
  dependencies      task_dependencies[]  @relation("TaskDependencies")
  requiredBy        task_dependencies[]  @relation("RequiredByDependencies")

  @@index([spec_id, status])
  @@index([parent_id])
}

// ============================================================
// TASK_DEPENDENCIES — Grafo de prerrequisitos entre tareas
// ============================================================

model task_dependencies {
  task_id          Int
  required_task_id Int

  task         tasks @relation("TaskDependencies", fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requiredTask tasks @relation("RequiredByDependencies", fields: [required_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, required_task_id])
  @@index([required_task_id])
}

// ============================================================
// SESSION_LOGS — Bitácoras de sesiones de trabajo
// ============================================================

model session_logs {
  id               Int    @id @default(autoincrement())
  task_id          Int
  session_id       String                                             /// Identificador de sesión no vacío
  overview         String                                             /// Resumen Markdown no vacío
  taken_decisions  String @default("[]")                              /// JSON array de { decision, gap, justify }
  files_changed    String @default("[]")                              /// JSON array de { type, file, reason }
  created_at       String @default("CURRENT_TIMESTAMP")

  task             tasks  @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([task_id, session_id])
  @@index([task_id, created_at])
}

// ============================================================
// VISTA: spec_definition_states
//
// Prisma no soporta vistas SQLite como modelos. Esta consulta raw
// reemplaza el modelo que no podemos generar automáticamente.
//
// SELECT
//   specs.id AS spec_id,
//   CASE
//     WHEN EXISTS (
//       SELECT 1 FROM definition_items
//       WHERE definition_items.spec_id = specs.id
//         AND definition_items.status = 'pending'
//     ) THEN 'draft'
//     ELSE 'defined'
//   END AS definition_status
// FROM specs
//
// Uso desde TypeScript:
//   prisma.$queryRaw<Array<{ spec_id: number; definition_status: string }>>`
//     SELECT ... FROM specs
//   `
// ============================================================
//
// TRIGGERS (administrados por scaffold_db.py, no por Prisma Migrate):
// - specs: touch_updated_at, validate_current_revision, prevent_clearing_current
// - spec_revisions: are_immutable, become_current, require_sequential
// - definition_items: start_pending, validate_status_transition,
//   capture_accepted_revision, validate_accepted_revision, touch_updated_at
// - definition_responses: prevent_changes_after_incorporation
// - tasks: touch_updated_at, prevent_spec_change, validate_parent,
//   require_completed_dependencies
// - task_dependencies: validate_before_insert/update
// - session_logs: validate_json_before_insert/update
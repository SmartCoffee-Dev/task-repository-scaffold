generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TRIGGERS (managed by scaffold_db.py — not by Prisma Migrate):
//
// definition_items:
//   - definition_items_capture_accepted_revision: records accepted_revision_number when status changes to accepted
//   - definition_items_start_pending: new items default to status='pending'
//   - definition_items_touch_updated_at: updates updated_at on modification
//   - definition_items_validate_accepted_revision_number: accepted_revision_number must be > 0 when status is accepted
//   - definition_items_validate_status_transition: enforces valid state transitions
//
// definition_responses:
//   - definition_responses_prevent_changes_after_incorporation: blocks modifications after item is incorporated
//
// session_logs:
//   - session_logs_validate_json_before_insert: validates taken_decisions and files_changed are valid JSON on insert
//   - session_logs_validate_json_before_update: validates taken_decisions and files_changed are valid JSON on update
//
// spec_revisions:
//   - spec_revisions_are_immutable: prevents updates to existing revisions
//   - spec_revisions_become_current: updates spec's current_revision_id when revision is created
//   - spec_revisions_require_sequential_numbers: enforces sequential revision_number per spec
//
// specs:
//   - specs_prevent_clearing_current_revision: prevents setting current_revision_id to NULL
//   - specs_touch_updated_at: updates updated_at on modification
//   - specs_validate_current_revision_before_update: validates current_revision_id references exist
//
// task_dependencies:
//   - task_dependencies_validate_before_insert: prevents self-referential and cross-spec dependencies
//   - task_dependencies_validate_before_update: same validation on update
//
// tasks:
//   - tasks_prevent_spec_change: blocks changing spec_id after creation
//   - tasks_require_completed_dependencies: prevents advancing status beyond pending unless dependencies are done
//   - tasks_touch_updated_at: updates updated_at on modification
//   - tasks_validate_parent_before_insert: validates parent_id references and hierarchy rules
//   - tasks_validate_parent_before_update: same validation on update
//
// VIEWS:
//   - spec_definition_states: computed status of specs based on definition_items

model definition_items {
  id                          Int                    @id @default(autoincrement())
  spec_id                     Int
  type                        String
  source                      String
  title                       String
  description                 String
  question                    String?
  suggested_resolution        String?
  example_type                String?
  fingerprint                 String
  status                      String                 @default("pending")
  accepted_revision_number    Int                    @default(0)
  incorporated_in_revision_id Int?
  created_at                  String                 @default("CURRENT_TIMESTAMP")
  updated_at                  String                 @default("CURRENT_TIMESTAMP")
  spec_revisions              spec_revisions?        @relation(fields: [incorporated_in_revision_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  specs                       specs                  @relation(fields: [spec_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  definition_responses        definition_responses[]

  @@index([spec_id, type], map: "definition_items_by_spec_and_type")
  @@index([spec_id, status], map: "definition_items_by_spec_and_status")
}

model definition_responses {
  id                 Int              @id @default(autoincrement())
  definition_item_id Int
  response_type      String
  content            String           @default("")
  created_at         String           @default("CURRENT_TIMESTAMP")
  definition_items   definition_items @relation(fields: [definition_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([definition_item_id, created_at], map: "definition_responses_by_item_and_created_at")
}

model session_logs {
  id              Int    @id @default(autoincrement())
  task_id         Int
  session_id      String
  overview        String
  taken_decisions String @default("[]")
  files_changed   String @default("[]")
  created_at      String @default("CURRENT_TIMESTAMP")
  tasks           tasks  @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([task_id, session_id], map: "sqlite_autoindex_session_logs_1")
  @@index([task_id, created_at], map: "session_logs_by_task_and_created_at")
}

model spec_revisions {
  id                                              Int                @id @default(autoincrement())
  spec_id                                         Int
  revision_number                                 Int
  content                                         String
  created_at                                      String             @default("CURRENT_TIMESTAMP")
  definition_items                                definition_items[]
  specs_spec_revisions_spec_idTospecs             specs              @relation("spec_revisions_spec_idTospecs", fields: [spec_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  specs_specs_current_revision_idTospec_revisions specs[]            @relation("specs_current_revision_idTospec_revisions")

  @@unique([spec_id, revision_number], map: "sqlite_autoindex_spec_revisions_1")
  @@index([spec_id, created_at], map: "spec_revisions_by_spec_and_created_at")
}

model specs {
  id                                                       Int                @id @default(autoincrement())
  title                                                    String
  slug                                                     String             @unique(map: "sqlite_autoindex_specs_1")
  description                                              String
  current_revision_id                                      Int?
  created_at                                               String             @default("CURRENT_TIMESTAMP")
  updated_at                                               String             @default("CURRENT_TIMESTAMP")
  definition_items                                         definition_items[]
  spec_revisions_spec_revisions_spec_idTospecs             spec_revisions[]   @relation("spec_revisions_spec_idTospecs")
  spec_revisions_specs_current_revision_idTospec_revisions spec_revisions?    @relation("specs_current_revision_idTospec_revisions", fields: [current_revision_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tasks                                                    tasks[]
}

model task_dependencies {
  task_id                                         Int
  required_task_id                                Int
  tasks_task_dependencies_required_task_idTotasks tasks @relation("task_dependencies_required_task_idTotasks", fields: [required_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks_task_dependencies_task_idTotasks          tasks @relation("task_dependencies_task_idTotasks", fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([task_id, required_task_id])
  @@index([required_task_id], map: "task_dependencies_by_required_task")
}

model tasks {
  id                                                          Int                 @id @default(autoincrement())
  spec_id                                                     Int
  title                                                       String
  description                                                 String
  status                                                      String              @default("pending")
  parent_id                                                   Int?
  branch                                                      String?
  created_at                                                  String              @default("CURRENT_TIMESTAMP")
  updated_at                                                  String              @default("CURRENT_TIMESTAMP")
  session_logs                                                session_logs[]
  task_dependencies_task_dependencies_required_task_idTotasks task_dependencies[] @relation("task_dependencies_required_task_idTotasks")
  task_dependencies_task_dependencies_task_idTotasks          task_dependencies[] @relation("task_dependencies_task_idTotasks")
  tasks                                                       tasks?              @relation("tasksTotasks", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_tasks                                                 tasks[]             @relation("tasksTotasks")
  specs                                                       specs               @relation(fields: [spec_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_id], map: "tasks_by_parent")
  @@index([spec_id, status], map: "tasks_by_spec_and_status")
}
